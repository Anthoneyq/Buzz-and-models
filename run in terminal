/bin/bash <<'BUZZ_FRESH_MAC'
# Fresh M1 Max / 64 GB Mac: Buzz, Ollama, coding tools, and six models.
set -Eeuo pipefail
umask 022
fail() { printf '\nSTOP: %s\n' "$*" >&2; exit 1; }
[[ "$(uname -s)" == Darwin ]] || fail "Run this on the Mac, not Windows."
[[ "$(uname -m)" == arm64 ]] || fail "Open native Mac Terminal, not Rosetta."
[[ "$(id -u)" != 0 ]] || fail "Paste as your normal Mac user, not root."
[[ "$(sw_vers -productVersion | cut -d. -f1)" -ge 15 ]] || fail "Update to macOS 15 or newer, then paste again."
[[ "$(sysctl -n hw.memsize)" -ge 64424509440 ]] || fail "This setup is intended for a 64 GB Mac."

ROOT="$HOME/Library/Application Support/BuzzLocalAI"
PLIST="$HOME/Library/LaunchAgents/local.buzz.ollama.plist"
SERVICE="gui/$(id -u)/local.buzz.ollama"
OLLAMA="/Applications/Ollama.app/Contents/Resources/ollama"
STAMP="$(date +%Y%m%d-%H%M%S)"
mkdir -p "$ROOT/logs" "$ROOT/tests" "$HOME/Library/LaunchAgents" "$HOME/Desktop"
chmod 700 "$ROOT" "$ROOT/logs" "$ROOT/tests"
exec > >(tee "$ROOT/logs/setup-$STAMP.log") 2>&1
trap 'echo "Setup stopped at line $LINENO. Log: $ROOT/logs/setup-$STAMP.log"' ERR
TMP="$(mktemp -d)"
SUDO_PID=""
cleanup() {
  [[ -z "$SUDO_PID" ]] || kill "$SUDO_PID" 2>/dev/null || true
  hdiutil detach "$TMP/mount" -quiet >/dev/null 2>&1 || true
  rm -rf "$TMP"
}
trap cleanup EXIT
/usr/bin/caffeinate -is -w "$$" >/dev/null 2>&1 &
FREE_KB="$(df -Pk "$HOME" | awk 'NR==2 {print $4}')"
[[ "$FREE_KB" -ge 244140625 ]] || echo "WARNING: Allow about 250 GB free for downloads, fallbacks, and tools."

# Stop only an earlier copy of this setup's service.
launchctl bootout "$SERVICE" >/dev/null 2>&1 || true
sleep 2
if /usr/sbin/lsof -nP -iTCP:11434 -sTCP:LISTEN >/dev/null 2>&1; then
  fail "Another server uses port 11434. Stop that server before rerunning."
fi

echo "Installing prerequisites. Enter your Mac login password when requested."
sudo -v </dev/tty
( while kill -0 "$$" 2>/dev/null; do sudo -n -v || exit; sleep 45; done ) >/dev/null 2>&1 &
SUDO_PID=$!
export HOMEBREW_NO_ANALYTICS=1
if [[ ! -x /opt/homebrew/bin/brew ]]; then
  curl -fSL --retry 3 --connect-timeout 20 \
    https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh -o "$TMP/brew-install.sh"
  NONINTERACTIVE=1 /bin/bash "$TMP/brew-install.sh" </dev/tty
fi
[[ -x /opt/homebrew/bin/brew ]] || fail "Homebrew installation did not complete."
eval "$(/opt/homebrew/bin/brew shellenv)"
brew install git node@24 python@3.13
cat > "$ROOT/environment.sh" <<'ENVIRONMENT'
export PATH="/opt/homebrew/opt/node@24/bin:/opt/homebrew/opt/python@3.13/libexec/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:$PATH"
ENVIRONMENT
source "$ROOT/environment.sh"
for profile in "$HOME/.zprofile" "$HOME/.bash_profile"; do
  touch "$profile"
  grep -Fq 'BuzzLocalAI/environment.sh' "$profile" || \
    printf '\nsource "$HOME/Library/Application Support/BuzzLocalAI/environment.sh"\n' >> "$profile"
done
git --version
node --version
npm --version
python3 --version

echo "Installing Buzz desktop..."
BUZZ_APP="/Applications/Buzz.app"
if [[ ! -d "$BUZZ_APP" && -d "$HOME/Applications/Buzz.app" ]]; then
  BUZZ_APP="$HOME/Applications/Buzz.app"
fi
if [[ ! -d "$BUZZ_APP" ]]; then
  curl -fSL --retry 3 --connect-timeout 20 \
    https://github.com/block/buzz/releases/download/desktop-v0.5.23/Buzz_0.5.23_aarch64.dmg \
    -o "$TMP/Buzz.dmg"
  printf '%s  %s\n' \
    '9197dde29a09ade77f56677e07cb4d6a9d7d1a6a157d7212f0a050144059c5b2' \
    "$TMP/Buzz.dmg" | shasum -a 256 -c -
  mkdir -p "$TMP/mount"
  hdiutil attach "$TMP/Buzz.dmg" -readonly -nobrowse -mountpoint "$TMP/mount" -quiet
  [[ -d "$TMP/mount/Buzz.app" ]] || fail "Buzz.app is missing from the installer."
  sudo ditto "$TMP/mount/Buzz.app" "$BUZZ_APP"
  hdiutil detach "$TMP/mount" -quiet
fi

echo "Installing Ollama and its included model runtimes..."
curl -fSL --retry 3 --connect-timeout 20 \
  https://ollama.com/install.sh -o "$TMP/ollama-install.sh"
OLLAMA_NO_START=1 /bin/sh "$TMP/ollama-install.sh" </dev/tty
[[ -x "$OLLAMA" ]] || fail "Ollama installation did not complete."
kill "$SUDO_PID" 2>/dev/null || true
SUDO_PID=""
umask 077
export OLLAMA_HOST="127.0.0.1:11434"

# One loaded model and one inference request at a time to start.
cat > "$ROOT/serve.sh" <<'SERVER'
#!/bin/bash
set -euo pipefail
export OLLAMA_HOST="127.0.0.1:11434"
export OLLAMA_MODELS="$HOME/.ollama/models"
export OLLAMA_NO_CLOUD=1
export OLLAMA_MAX_LOADED_MODELS=1
export OLLAMA_NUM_PARALLEL=1
export OLLAMA_MAX_QUEUE=32
export OLLAMA_CONTEXT_LENGTH=16384
export OLLAMA_KEEP_ALIVE="2m"
unset HTTP_PROXY http_proxy
exec /usr/bin/caffeinate -s /Applications/Ollama.app/Contents/Resources/ollama serve
SERVER
chmod 700 "$ROOT/serve.sh"
[[ ! -f "$PLIST" ]] || cp "$PLIST" "$ROOT/logs/service-backup-$STAMP.plist"
python3 - "$ROOT" "$PLIST" <<'PY'
import plistlib, sys
from pathlib import Path
root, target = map(Path, sys.argv[1:])
config = dict(Label="local.buzz.ollama", RunAtLoad=True, KeepAlive=True,
              ThrottleInterval=10, ProgramArguments=["/bin/bash", str(root / "serve.sh")],
              StandardOutPath=str(root / "logs/server.log"),
              StandardErrorPath=str(root / "logs/server-error.log"))
with target.open("wb") as f:
    plistlib.dump(config, f)
PY
launchctl enable "$SERVICE"
launchctl bootstrap "gui/$(id -u)" "$PLIST"
READY=0
for attempt in {1..60}; do
  if curl --noproxy '*' -fsS --max-time 2 http://127.0.0.1:11434/api/version \
    > "$ROOT/logs/version.json" 2>/dev/null; then READY=1; break; fi
  sleep 2
done
[[ "$READY" -eq 1 ]] || fail "Ollama did not start. Check $ROOT/logs/server-error.log"

# Read-only tool-call test. Never executes commands produced by a model.
cat > "$ROOT/probe.py" <<'PY'
import json, sys, uuid, urllib.request
from pathlib import Path

model, folder = sys.argv[1:]
p = Path(folder)
p.mkdir(parents=True, exist_ok=True)
opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
token_file = p / "probe.txt"
token_file.write_text(str(uuid.uuid4()), encoding="utf-8")
body = {"model": model, "stream": False, "max_tokens": 1024,
        "messages": [{"role": "user", "content":
          "Call read_probe_file with filename probe.txt. After the tool returns, "
          "reply with only its token, without quotes or explanation."}],
        "tools": [{"type": "function", "function": {
          "name": "read_probe_file", "description": "Read the local test file.",
          "parameters": {"type": "object", "properties": {
            "filename": {"type": "string", "enum": ["probe.txt"]}},
            "required": ["filename"], "additionalProperties": False}}}]}
if "reviewer" not in model and "coder-max" not in model:
    body["reasoning_effort"] = "none"

def request(payload):
    return opener.open(urllib.request.Request(
        "http://127.0.0.1:11434/v1/chat/completions",
        data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json"}), timeout=1800)

try:
    with request(body) as response:
        raw = response.read().decode()
    (p / "first-response.json").write_text(raw, encoding="utf-8")
    message = json.loads(raw)["choices"][0]["message"]
    calls = message.get("tool_calls") or []
    if len(calls) != 1:
        raise ValueError("Expected one structured tool call.")
    call = calls[0]
    function = call["function"]
    args = function["arguments"]
    args = json.loads(args) if isinstance(args, str) else args
    if not call.get("id") or function["name"] != "read_probe_file" or args != {"filename": "probe.txt"}:
        raise ValueError("Invalid tool name, ID, or arguments.")
    token = token_file.read_text(encoding="utf-8").strip()
    body["messages"] += [message, {"role": "tool", "tool_call_id": call["id"],
                                 "content": json.dumps({"token": token})}]
    body["stream"] = True
    parts, done, finish = [], False, None
    with request(body) as response, (p / "stream.txt").open("w", encoding="utf-8") as log:
        for raw_line in response:
            line = raw_line.decode()
            log.write(line)
            if not line.startswith("data:"):
                continue
            data = line[5:].strip()
            if data == "[DONE]":
                done = True
                break
            if not data:
                continue
            event = json.loads(data)
            if event.get("error"):
                raise ValueError(str(event["error"]))
            for choice in event.get("choices", []):
                parts.append(choice.get("delta", {}).get("content") or "")
                finish = choice.get("finish_reason") or finish
    if not done or finish != "stop" or "".join(parts).strip() != token:
        raise ValueError("Tool-result/streaming test did not complete correctly.")
    print("PASS: local tool-call and streaming test")
except Exception as exc:
    print(f"NOT VERIFIED: {model}: {exc}", file=sys.stderr)
    sys.exit(1)
PY

REPORT="$ROOT/results-$STAMP.txt"
printf 'LOCAL API TESTS - not full Buzz workflow verification\n\n' > "$REPORT"
FAILED=0
while IFS='|' read -r name preferred fallback context; do
  OK=0
  for source in "$preferred" "$fallback"; do
    [[ -n "$source" ]] || continue
    printf '\n=== Downloading/testing %s: %s ===\n' "$name" "$source"
    printf 'FROM %s\nPARAMETER num_ctx %s\n' "$source" "$context" > "$ROOT/Modelfile"
    if "$OLLAMA" pull "$source" && "$OLLAMA" create "$name" -f "$ROOT/Modelfile" && \
       python3 "$ROOT/probe.py" "$name" "$ROOT/tests/${name//:/-}"; then
      printf 'PASS | %s | %s | context %s\n' "$name" "$source" "$context" >> "$REPORT"
      "$OLLAMA" ps >> "$REPORT" || true
      OK=1
    else
      printf 'ATTEMPT FAILED | %s | %s\n' "$name" "$source" >> "$REPORT"
    fi
    "$OLLAMA" stop "$name" >/dev/null 2>&1 || true
    [[ "$OK" -eq 0 ]] || break
  done
  if [[ "$OK" -eq 0 ]]; then
    FAILED=$((FAILED + 1))
    printf 'NOT READY | %s\n' "$name" >> "$REPORT"
  fi
done <<'MODELS'
buzz-worker-4b:latest|qwen3.5:4b-mxfp8|qwen3.5:4b-q8_0|8192
buzz-worker-9b:latest|qwen3.5:9b-mxfp8|qwen3.5:9b-q8_0|16384
buzz-worker-12b:latest|gemma4:12b-mxfp8|gemma4:12b-it-q8_0|16384
buzz-reasoner:latest|qwen3.8:27b-mxfp8|qwen3.8:27b-q8_0|32768
buzz-reviewer:latest|devstral-small-2:24b-instruct-2512-q8_0||32768
buzz-coder-max:latest|qwen3-coder-next:q4_K_M||16384
MODELS

# Disposable project for a real test from inside Buzz.
PROJECT="$HOME/BuzzProjects/SetupCheck-$STAMP"
mkdir -p "$PROJECT"
printf 'module.exports.add = (a, b) => a - b;\n' > "$PROJECT/add.cjs"
printf "const {add}=require('./add.cjs'); require('node:assert/strict').equal(add(2,3),5); console.log('PASS');\n" > "$PROJECT/test.cjs"
/usr/bin/uuidgen > "$PROJECT/CHECK_TOKEN.txt"

# Use this launcher so Buzz can find the newly installed development tools.
printf '%s\n' "$BUZZ_APP" > "$ROOT/buzz-app-path.txt"
cat > "$HOME/Desktop/Start Buzz Local.command" <<'LAUNCHER'
#!/bin/bash
set -euo pipefail
ROOT="$HOME/Library/Application Support/BuzzLocalAI"
source "$ROOT/environment.sh"
launchctl setenv PATH "$PATH"
launchctl setenv BUZZ_AGENT_LLM_TIMEOUT_SECS 3600
launchctl setenv BUZZ_AGENT_MAX_ROUNDS 30
launchctl setenv BUZZ_AGENT_MAX_PARALLEL_TOOLS 1
PLIST="$HOME/Library/LaunchAgents/local.buzz.ollama.plist"
launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null || true
open "$(cat "$ROOT/buzz-app-path.txt")"
LAUNCHER
chmod 700 "$HOME/Desktop/Start Buzz Local.command"

NOTES="$HOME/Desktop/Buzz AI Setup.txt"
cat > "$NOTES" <<NOTES
BUZZ LOCAL AI - FRESH MAC SETUP

Installed: Buzz, Ollama, Git, Node.js/npm, Python, and downloaded models.
Only use model aliases marked PASS below. Others require investigation.

FINISH INSIDE BUZZ
1. Create/import your identity; connect to your existing community or invitation.
   No relay server was installed. Do not leave it pointing at localhost:3000
   unless you separately run a relay there. Keep private identity keys private.
2. Add a LOCAL agent using OpenAI-compatible/custom provider:
   Base URL: http://127.0.0.1:11434/v1
   API key: ollama (placeholder, not a paid account key)
   First model to try: buzz-worker-9b:latest (only if it passed).
   Select the actual model alias, not its underlying download tag.
3. Grant the agent access only to the test project below; add it to a channel.
   Project: $PROJECT
   Ask it: Read CHECK_TOKEN.txt and report its exact content. Fix add.cjs so
   add(2,3) equals 5. Run node test.cjs and report the actual test output.

MODELS
buzz-coder-max:latest = Qwen3-Coder-Next 80B (tight memory fit)
buzz-reasoner:latest = Qwen3.8 27B
buzz-reviewer:latest = Devstral Small 2 24B
buzz-worker-9b:latest = Qwen3.5 9B
buzz-worker-12b:latest = Gemma 4 12B
buzz-worker-4b:latest = Qwen3.5 4B

Qwen reasoning/workers and Gemma try MLX first, then a listed GGUF fallback.
Coder and reviewer use GGUF. Exact working builds appear in the results.
Context caps: reasoner/reviewer 32768; 4B worker 8192; others 16384.
Agent history + tool definitions/results + output must fit those caps.
A local API pass is not proof of Buzz or repository-scale reliability.

STARTUP / LIMITS
Use the Desktop 'Start Buzz Local.command' launcher.
Ollama starts automatically after Mac login; do not start a second server.
Keep AC power connected and the lid open. Sleep is inhibited on AC while
this service runs. It does not run before login or bypass a closed lid.
One model/request at a time is enabled initially; other requests queue.
Agents, parallel-worker orchestration, and hourly jobs were NOT created.
Windows projects, credentials, and project-specific dependencies were NOT moved.
Model inference is local. Buzz messages still go to your selected relay.

Logs: $ROOT/logs
Tests: $ROOT/tests
Stop Ollama: launchctl bootout "$SERVICE"
Start Ollama: launchctl bootstrap "gui/$(id -u)" "$PLIST"

RESULTS
NOTES
cat "$REPORT" >> "$NOTES"
cat "$REPORT"
printf '\nModels needing attention: %s\nRead: %s\n' "$FAILED" "$NOTES"
/bin/bash "$HOME/Desktop/Start Buzz Local.command" || echo "Open Buzz manually if macOS requests approval."
open -a TextEdit "$NOTES" || true
BUZZ_FRESH_MAC
